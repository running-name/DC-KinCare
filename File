<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DISTRICT OF COLUMBIA CUSTODIAL POWER OF ATTORNEY</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load jsPDF for client-side PDF generation -->
    <script src="https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f9fc;
        }
        /* Styling for the HTML preview area */
        #document-preview {
            line-height: 1.6;
            font-family: 'Times New Roman', serif;
            font-size: 11pt;
            background-color: white;
            padding: 3rem;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            min-height: 100vh;
            border-radius: 0.5rem;
            overflow-x: auto;
        }
        /* Custom styles for the initialing line in the form */
        .initial-check-label {
            display: flex;
            align-items: center;
            padding: 0.75rem;
            border: 1px solid #e5e7eb;
            border-radius: 0.375rem;
            margin-bottom: 0.5rem;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .initial-check-label:hover {
            background-color: #f9fafb;
        }
        .initial-check-label input:checked + span {
            font-weight: 600;
            color: #1d4ed8;
        }
        .initial-check-label input:checked ~ p {
            font-weight: 500;
        }
        /* Responsive layout for the main form and preview */
        @media (min-width: 1024px) {
            #main-container {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body class="p-4 md:p-8">

    <header class="text-center mb-10">
        <h1 class="text-3xl font-extrabold text-gray-900">DISTRICT OF COLUMBIA CUSTODIAL POWER OF ATTORNEY PURSUANT TO D.C. CODE § 21-2301</h1>
        <p class="text-lg text-gray-600 mt-2">Fill out the form to generate the legal text for a CPOA.</p>
        <p class="text-sm text-red-600 mt-1 font-medium">Disclaimer: This is for educational and informational purposes only. Consult a legal professional before execution.</p>
    </header>

    <div id="main-container" class="grid lg:grid-cols-2 gap-8 max-w-7xl mx-auto">

        <!-- Form Panel -->
        <div class="p-6 bg-white rounded-xl shadow-lg h-fit sticky top-8" id="cpoa-form">
            <h2 class="text-2xl font-semibold mb-6 text-gray-800 border-b pb-3">1. Document Details & Parties</h2>
            
            <form id="generatorForm">

                <!-- Language Selection -->
                <fieldset class="mb-6 p-4 border rounded-lg border-red-200">
                    <legend class="px-2 text-lg font-medium text-red-700">Language Options</legend>
                    <label for="language" class="block text-sm font-medium text-gray-700 mb-2">Select Document Language:</label>
                    <select id="language" required class="w-full p-2 border border-gray-300 rounded-md focus:ring-red-500 focus:border-red-500">
                        <option value="english">English</option>
                        <option value="spanish">Spanish</option>
                    </select>
                </fieldset>
                
                <!-- Parent (Grantor) Info -->
                <fieldset class="mb-6 p-4 border rounded-lg border-blue-200">
                    <legend class="px-2 text-lg font-medium text-blue-700">Parent (Grantor)</legend>
                    <input type="text" id="parentName" placeholder="Full Legal Name of Parent" required class="w-full p-2 border border-gray-300 rounded-md mb-3 focus:ring-blue-500 focus:border-blue-500">
                    <input type="text" id="parentAddress" placeholder="Full Address" required class="w-full p-2 border border-gray-300 rounded-md mb-3 focus:ring-blue-500 focus:border-blue-500">
                    <input type="tel" id="parentPhone" placeholder="Phone Number" class="w-full p-2 border border-gray-300 rounded-md mb-3 focus:ring-blue-500 focus:border-blue-500">
                </fieldset>

                <!-- Attorney-in-Fact (Grantee) Info -->
                <fieldset class="mb-6 p-4 border rounded-lg border-green-200">
                    <legend class="px-2 text-lg font-medium text-green-700">Attorney-in-Fact (Grantee)</legend>
                    <input type="text" id="agentName" placeholder="Full Legal Name of Attorney-in-Fact" required class="w-full p-2 border border-gray-300 rounded-md mb-3 focus:ring-green-500 focus:border-green-500">
                    <input type="text" id="agentAddress" placeholder="Full Address" required class="w-full p-2 border border-gray-300 rounded-md mb-3 focus:ring-green-500 focus:border-green-500">
                    <input type="tel" id="agentPhone" placeholder="Phone Number" class="w-full p-2 border border-gray-300 rounded-md mb-3 focus:ring-green-500 focus:border-green-500">
                </fieldset>
                
                <!-- Child Info -->
                <fieldset class="mb-6 p-4 border rounded-lg border-purple-200">
                    <legend class="px-2 text-lg font-medium text-purple-700">Child(ren) Information (Max 6)</legend>
                    <div id="children-container">
                        <!-- Child 1 -->
                        <div class="flex space-x-2 mb-3">
                            <input type="text" name="childName" placeholder="Child 1 Name" required class="w-3/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <input type="date" name="childDOB" required class="w-2/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                        </div>
                        <!-- Child 2 (Optional) -->
                        <div class="flex space-x-2 mb-3">
                            <input type="text" name="childName" placeholder="Child 2 Name (Optional)" class="w-3/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <input type="date" name="childDOB" class="w-2/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                        </div>
                        <!-- Child 3 (Optional) -->
                        <div class="flex space-x-2 mb-3">
                            <input type="text" name="childName" placeholder="Child 3 Name (Optional)" class="w-3/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <input type="date" name="childDOB" class="w-2/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                        </div>
                        <!-- Child 4 (Optional) -->
                        <div class="flex space-x-2 mb-3">
                            <input type="text" name="childName" placeholder="Child 4 Name (Optional)" class="w-3/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <input type="date" name="childDOB" class="w-2/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                        </div>
                        <!-- Child 5 (Optional) -->
                        <div class="flex space-x-2 mb-3">
                            <input type="text" name="childName" placeholder="Child 5 Name (Optional)" class="w-3/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <input type="date" name="childDOB" class="w-2/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                        </div>
                        <!-- Child 6 (Optional) -->
                        <div class="flex space-x-2 mb-3">
                            <input type="text" name="childName" placeholder="Child 6 Name (Optional)" class="w-3/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <input type="date" name="childDOB" class="w-2/5 p-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                        </div>
                    </div>
                </fieldset>

                <!-- Dates -->
                <fieldset class="mb-8 p-4 border rounded-lg border-yellow-200">
                    <legend class="px-2 text-lg font-medium text-yellow-700">Effective and Expiration Dates</legend>
                    <div class="flex space-x-4">
                        <div class="w-1/2">
                            <label for="effectiveDate" class="block text-sm font-medium text-gray-700">Effective Date</label>
                            <input type="date" id="effectiveDate" required class="w-full p-2 border border-gray-300 rounded-md focus:ring-yellow-500 focus:border-yellow-500 mt-1">
                        </div>
                        <div class="w-1/2">
                            <label for="expirationDate" class="block text-sm font-medium text-gray-700">Expiration Date</label>
                            <input type="date" id="expirationDate" required class="w-full p-2 border border-gray-300 rounded-md focus:ring-yellow-500 focus:border-yellow-500 mt-1">
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-2">CPOAs typically have a maximum duration (e.g., 6 or 12 months, depending on state law).</p>
                </fieldset>


                <!-- Granted Powers -->
                <h2 class="text-2xl font-semibold mb-6 text-gray-800 border-b pb-3">2. Granted Powers (Initial to Select)</h2>
                <div class="space-y-3 mb-8">
                    <label class="initial-check-label bg-blue-50">
                        <input type="checkbox" name="powers" value="custody" class="h-5 w-5 text-blue-600 border-gray-300 rounded mr-3">
                        <span class="font-mono text-gray-500">P.C.</span>
                        <p class="ml-4 text-gray-800 flex-1">Physical Custody and Control of the Child(ren).</p>
                    </label>
                    <label class="initial-check-label bg-blue-50">
                        <input type="checkbox" name="powers" value="school" class="h-5 w-5 text-blue-600 border-gray-300 rounded mr-3">
                        <span class="font-mono text-gray-500">S.E.</span>
                        <p class="ml-4 text-gray-800 flex-1">Authority to enroll the child(ren) in school and make educational decisions.</p>
                    </label>
                    <label class="initial-check-label bg-blue-50">
                        <input type="checkbox" name="powers" value="records" class="h-5 w-5 text-blue-600 border-gray-300 rounded mr-3">
                        <span class="font-mono text-gray-500">R.A.</span>
                        <p class="ml-4 text-gray-800 flex-1">Authority to obtain educational, medical, mental health, and dental records.</p>
                    </label>
                    <label class="initial-check-label bg-blue-50">
                        <input type="checkbox" name="powers" value="treatment" class="h-5 w-5 text-blue-600 border-gray-300 rounded mr-3">
                        <span class="font-mono text-gray-500">M.C.</span>
                        <p class="ml-4 text-gray-800 flex-1">Authority to consent to medical, mental health, or dental treatment.</p>
                    </label>
                    <label class="initial-check-label bg-blue-50">
                        <input type="checkbox" name="powers" value="travel" class="h-5 w-5 text-blue-600 border-gray-300 rounded mr-3">
                        <span class="font-mono text-gray-500">I.T.</span>
                        <p class="ml-4 text-gray-800 flex-1">Authority to consent to domestic or international travel.</p>
                    </label>
                    <label class="initial-check-label bg-blue-50">
                        <input type="checkbox" name="powers" value="payee" class="h-5 w-5 text-blue-600 border-gray-300 rounded mr-3">
                        <span class="font-mono text-gray-500">S.S.</span>
                        <p class="ml-4 text-gray-800 flex-1">Authority to act as a representative payee for Social Security or receive other benefits.</p>
                    </label>
                </div>

                <button type="submit" class="w-full bg-indigo-600 text-white p-3 rounded-xl font-bold hover:bg-indigo-700 transition duration-150 shadow-md">
                    UPDATE DOCUMENT PREVIEW
                </button>
            </form>
        </div>

        <!-- Document Preview Panel -->
        <div class="flex flex-col">
            <h2 class="text-2xl font-semibold mb-6 text-gray-800 border-b pb-3">Document Preview</h2>
            <div id="document-preview" class="flex-1">
                <p class="text-center text-gray-500 italic">Document text will appear here after you update the preview.</p>
            </div>
            <div class="mt-4 flex space-x-4">
                <button onclick="copyDocument()" id="copyButton" class="flex-1 bg-teal-500 text-white p-3 rounded-xl font-bold hover:bg-teal-600 transition duration-150 shadow-md" disabled>
                    Copy Plain Text
                </button>
                <button onclick="downloadPDF()" id="pdfButton" class="flex-1 bg-red-600 text-white p-3 rounded-xl font-bold hover:bg-red-700 transition duration-150 shadow-md" disabled>
                    Download PDF (Corrected Format)
                </button>
            </div>
        </div>
    </div>

    <script>
        // Check for jsPDF module availability
        const { jsPDF } = window.jspdf;
        if (typeof jsPDF === 'undefined') {
            console.error("jsPDF library not loaded. PDF functionality disabled.");
        }

        document.getElementById('generatorForm').addEventListener('submit', function(event) {
            event.preventDefault();
            generateDocument();
        });
        
        // --- DATA COLLECTION AND FORMATTING ---
        
        function formatDate(dateString) {
            if (!dateString) return "____, 20__";
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            try {
                return new Date(dateString + 'T00:00:00').toLocaleDateString('en-US', options);
            } catch (e) {
                console.error("Date formatting failed:", e);
                return "____, 20__";
            }
        }

        function collectFormData() {
            const form = document.getElementById('generatorForm');

            // Collect basic text data
            const data = {
                language: form.language.value,
                parentName: form.parentName.value.trim() || "_________________________",
                parentAddress: form.parentAddress.value.trim() || "_________________________",
                parentPhone: form.parentPhone.value.trim() || "_________________________",
                agentName: form.agentName.value.trim() || "_________________________",
                agentAddress: form.agentAddress.value.trim() || "_________________________",
                agentPhone: form.agentPhone.value.trim() || "_________________________",
                effectiveDate: formatDate(form.effectiveDate.value),
                expirationDate: formatDate(form.expirationDate.value),
                dateSigned: formatDate(new Date().toISOString().substring(0, 10)), // Date today
            };

            // Collect child data (up to 6)
            data.children = [];
            const childInputs = document.querySelectorAll('#children-container > div');
            childInputs.forEach(div => {
                const nameInput = div.querySelector('input[name="childName"]');
                const dobInput = div.querySelector('input[name="childDOB"]');
                // Only include children where both name and DOB are provided
                if (nameInput.value.trim() && dobInput.value.trim()) {
                     data.children.push({ name: nameInput.value.trim(), dob: formatDate(dobInput.value) });
                }
            });

            if (data.children.length === 0) {
                 // Add a generic child placeholder if none are entered
                 data.children.push({ name: "_________________________", dob: "_________________________" });
            }

            // Collect granted powers
            data.powers = Array.from(document.querySelectorAll('input[name="powers"]:checked'))
                .map(input => input.value);
            
            return data;
        }


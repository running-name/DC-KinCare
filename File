                FOOTER: "PÁGINA 1 DE 2",
                FOOTER2: "PÁGINA 2 DE 2",
                
                SIGNED: "FIRMADO Y FECHADO este [DATE_SIGNED].",
                SIGN_PARENT_LINE: "Padre/Otorgante",
                SIGN_AGENT_LINE: "Apoderado (Aceptación del Nombramiento)",
                NOTARY_TITLE: "CERTIFICACIÓN NOTARIAL",
                NOTARY_STATE: "Distrito de Columbia",
                NOTARY_COUNTY: "Condado de",
                NOTARY_APPEAR: "En esta fecha, [DATE_SIGNED], ante mí, el Notario Público abajo firmante, compareció personalmente [PARENT_NAME] (Padre/Otorgante), conocido(a) por mí o satisfactoriamente probado(a) ser la persona cuyo nombre está suscrito en el presente instrumento, y reconoció que ejecutó el mismo para los fines contenidos en él.",
                NOTARY_WITNESS: "DOY FE con mi firma y sello oficial.",
                NOTARY_SIGN: "Firma del Notario Público",
                NOTARY_EXPIRE: "Mi Comisión Vence:",
            }
        };

        function getDocumentStructure(data, langKey) {
            const T = Translations[langKey];
            const isChecked = (power) => data.powers.includes(power) ? "X" : "___";
            const structure = [];

            // --- HEADER ---
            structure.push({ type: 'title', text: T.TITLE });

            // 1. APPOINTMENT OF ATTORNEY-IN-FACT
            structure.push({ type: 'heading', num: '1.', text: T.H1_APPOINTMENT });
            
            // Replicate I, [Parent Name]...
            const introParent = T.INTRO_APPOINTMENT
                .replace('[PARENT_NAME]', data.parentName)
                .replace('[ROLE_PARENT]', T.ROLE_PARENT)
                .replace('[PARENT_ADDRESS]', data.parentAddress)
                .replace('[PARENT_PHONE]', data.parentPhone);
            
            // Replicate [Agent Name]... hereby appoint:
            const introAgent = T.INTRO_AGENT
                .replace('[AGENT_NAME]', data.agentName)
                .replace('[ROLE_AGENT]', T.ROLE_AGENT)
                .replace('[AGENT_ADDRESS]', data.agentAddress)
                .replace('[AGENT_PHONE]', data.agentPhone);

            structure.push({ type: 'intro', text: introParent });
            structure.push({ type: 'intro', text: introAgent });
            structure.push({ type: 'paragraph', text: T.P1_APPOINTMENT });


            // 2. CHILDREN COVERED BY POWER OF ATTORNEY
            structure.push({ type: 'heading', num: '2.', text: T.H2_CHILDREN });
            structure.push({ type: 'paragraph', text: T.P2_CHILDREN_INTRO });

            // Children List
            data.children.forEach(child => {
                structure.push({ type: 'child-item', text: `${T.CHILD_NAME}: ${child.name}` });
                structure.push({ type: 'child-item', text: `${T.CHILD_DOB}: ${child.dob}` });
            });
            
            // 3. EFFECTIVE DATE AND TERMINATION
            structure.push({ type: 'heading', num: '3.', text: T.H3_TERM });
            const termParagraph = T.P3_TERM
                .replace('[EFFECTIVE_DATE]', data.effectiveDate)
                .replace('[EXPIRATION_DATE]', data.expirationDate);
            structure.push({ type: 'paragraph', text: termParagraph });

            // 4. GRANT OF AUTHORITY: CHECKLIST (The checklist intro)
            structure.push({ type: 'heading', num: '4.', text: T.H4_GRANT_INTRO });
            structure.push({ type: 'paragraph', text: T.P4_GRANT_INTRO });
            
            // --- INDIVIDUAL POWER SECTIONS (5-10) ---
            POWER_MAP.forEach((p, index) => {
                const sectionNum = index + 5;
                const H_KEY = `H${sectionNum}_${p.key.toUpperCase()}`;
                const P_KEY = `P${sectionNum}_${p.key.toUpperCase()}`;
                const P_TEXT_KEY = langKey === 'english' ? p.englishKey : p.spanishKey;

                // 5-10. Individual Powers
                structure.push({ type: 'heading', num: `${sectionNum}.`, text: T[H_KEY] });
                structure.push({ 
                    type: 'power-item', 
                    initial: p.initial, 
                    text: T[P_TEXT_KEY], 
                    checked: isChecked(p.key) 
                });
            });

            // 11. LIMITATIONS ON AUTHORITY
            structure.push({ type: 'heading', num: '11.', text: T.H11_LIMIT });
            structure.push({ type: 'paragraph', text: T.P11_LIMIT_INTRO.replace('NOT', '<strong>NOT</strong>') });
            
            // Limitation list (a, b, c)
            structure.push({ type: 'list-alpha', text: `a) ${T.L_A}` });
            structure.push({ type: 'list-alpha', text: `b) ${T.L_B}` });
            structure.push({ type: 'list-alpha', text: `c) ${T.L_C}` });

            structure.push({ type: 'paragraph-small', text: T.L_RESERVATION });

            // Page 1 Footer
            structure.push({ type: 'footer', text: T.FOOTER });

            // --- PAGE 2 ---
            
            // Force a good spot for page break detection in PDF.
            structure.push({ type: 'page-break-placeholder' }); 

            // 12. RELIANCE, REVOCATION, AND GOVERNING LAW
            structure.push({ type: 'heading', num: '12.', text: T.H12_CLOSING });
            structure.push({ type: 'paragraph-sub', text: T.P12_RELIANCE });
            structure.push({ type: 'paragraph-sub', text: T.P12_REVOC });
            structure.push({ type: 'paragraph-sub', text: T.P12_GOV_LAW });

            // SIGNATURES AND ACKNOWLEDGEMENT (Unnumbered section below 12)
            structure.push({ type: 'notary-separator' });
            structure.push({ type: 'notary-title', text: T.SIGNED.replace('[DATE_SIGNED]', `<strong>${data.dateSigned}</strong>`) });

            // Signatures
            structure.push({ type: 'signature-line', name: data.parentName, role: T.SIGN_PARENT_LINE });
            structure.push({ type: 'signature-line', name: data.agentName, role: T.SIGN_AGENT_LINE });
            
            // Notary Block
            const notaryParagraph = T.NOTARY_APPEAR
                .replace('[DATE_SIGNED]', `<strong>${data.dateSigned}</strong>`)
                .replace('[PARENT_NAME]', `<strong>${data.parentName}</strong>`);
            
            structure.push({ type: 'notary-separator-small' });
            structure.push({ type: 'notary-title', text: T.NOTARY_TITLE });
            structure.push({ type: 'notary-state', text: `${T.NOTARY_STATE} __________________________` });
            structure.push({ type: 'notary-state', text: `${T.NOTARY_COUNTY} _________________________` });
            structure.push({ type: 'notary-text', text: notaryParagraph });
            structure.push({ type: 'notary-witness', text: T.NOTARY_WITNESS });
            structure.push({ type: 'notary-sign-line', text: T.NOTARY_SIGN });
            structure.push({ type: 'notary-expire', text: `${T.NOTARY_EXPIRE} _________________` });
            structure.push({ type: 'notary-seal', text: '(Seal)' });
            
            structure.push({ type: 'footer', text: T.FOOTER2 });
            
            return structure;
        }

        function generateDocument() {
            collectedData = collectFormData();
            const preview = document.getElementById('document-preview');
            document.getElementById('copyButton').disabled = false;
            document.getElementById('pdfButton').disabled = false;
            
            let structures = [];
            const lang = collectedData.language;

            if (lang === 'english') {
                structures = structures.concat(getDocumentStructure(collectedData, 'english'));
            } else if (lang === 'spanish') {
                structures = structures.concat(getDocumentStructure(collectedData, 'spanish'));
            }

            // Convert Structure to HTML for Preview
            let htmlContent = '';
            structures.forEach(item => {
                switch(item.type) {
                    case 'title':
                        htmlContent += `<h1 class="text-center text-xl font-bold mb-6 mt-4">${item.text}</h1>`;
                        break;
                    case 'intro':
                        // Simple text with bolding for names
                        htmlContent += `<p class="mb-2">${item.text}</p>`;
                        break;
                    case 'child-item':
                        htmlContent += `<p class="ml-8 text-sm">${item.text}</p>`;
                        break;
                    case 'heading':
                        htmlContent += `<h3 class="font-bold mt-4 mb-2">${item.num} ${item.text}</h3>`;
                        break;
                    case 'paragraph':
                        htmlContent += `<p class="mb-3">${item.text}</p>`;
                        break;
                    case 'paragraph-sub': // Used for section 12 sub-points
                        htmlContent += `<p class="mb-3 text-sm ml-4 indent-[-16px]">${item.text}</p>`;
                        break;
                    case 'paragraph-small':
                        htmlContent += `<p class="mb-3 text-sm">${item.text}</p>`;
                        break;
                    case 'power-item':
                        // Recreate the initialed block for the HTML preview
                        htmlContent += `<div class="flex items-start mb-1 text-sm"><span class="font-mono border border-black px-2 mr-4">${item.checked}</span> <span class="font-mono text-xs text-gray-500 mr-4">${item.initial}.</span> <p class="flex-1">${item.text}</p></div>`;
                        break;
                    case 'list-alpha':
                        htmlContent += `<p class="ml-4 text-sm mb-1">${item.text}</p>`;
                        break;
                    case 'signature-intro':
                        htmlContent += `<p class="text-center mt-6 mb-8">${item.text}</p>`;
                        break;
                    case 'signature-line':
                        htmlContent += `<div class="mt-8 text-center border-t border-black pt-1 mb-12"><p class="text-sm"><strong>${item.name}</strong></p><p class="text-xs">${item.role}</p></div>`;
                        break;
                    case 'notary-separator':
                        htmlContent += `<hr class="my-8 border-t-2 border-dashed border-gray-400">`;
                        break;
                    case 'notary-separator-small':
                         htmlContent += `<hr class="my-4 border-t border-gray-300">`;
                         break;
                    case 'notary-title':
                        htmlContent += `<h4 class="text-center text-lg font-bold mt-8 mb-4">${item.text}</h4>`;
                        break;
                    case 'notary-state':
                        htmlContent += `<p class="text-sm mb-1">${item.text}</p>`;
                        break;
                    case 'notary-text':
                        htmlContent += `<p class="mt-4 mb-3">${item.text}</p>`;
                        break;
                    case 'notary-witness':
                        htmlContent += `<p class="mt-4 mb-8">${item.text}</p>`;
                        break;
                    case 'notary-sign-line':
                        htmlContent += `<div class="mt-8 border-t border-black pt-1 mb-2"><p class="text-sm">${item.text}</p></div>`;
                        break;
                    case 'notary-expire':
                    case 'notary-seal':
                        htmlContent += `<p class="text-sm mb-1">${item.text}</p>`;
                        break;
                    case 'footer':
                        htmlContent += `<div class="text-center text-xs mt-12 pt-4 border-t border-gray-200">${item.text}</div>`;
                        break;
                    case 'page-break-placeholder':
                        htmlContent += `<div style="height: 100px;"></div>`; // Visual separation in HTML
                        break;
                }
            });

            preview.innerHTML = htmlContent;
        }

        // --- EXPORT FUNCTIONS (Copy and PDF) ---

        // Function to copy the generated text (re-using existing logic)
        function copyDocument() {
            const preview = document.getElementById('document-preview');
            // Extract text content from the structured HTML for a clean copy
            const textToCopy = preview.textContent.trim(); 
            
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = textToCopy;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            
            try {
                document.execCommand('copy');
                const copyButton = document.getElementById('copyButton');
                copyButton.textContent = 'Copied to Clipboard!';
                copyButton.classList.remove('bg-teal-500', 'hover:bg-teal-600');
                copyButton.classList.add('bg-green-600', 'hover:bg-green-700');
                
                setTimeout(() => {
                    copyButton.textContent = 'Copy Plain Text';
                    copyButton.classList.remove('bg-green-600', 'hover:bg-green-700');
                    copyButton.classList.add('bg-teal-500', 'hover:bg-teal-600');
                }, 2000);
            } catch (err) {
                console.error('Failed to copy text: ', err);
            }
            document.body.removeChild(tempTextArea);
        }

        // Function to download the document as a professionally formatted PDF
        function downloadPDF() {
            if (typeof jsPDF === 'undefined') {
                alert("PDF generation error: jsPDF library not found.");
                return;
            }

            const doc = new jsPDF('p', 'pt', 'letter');
            
            let structures = [];
            const lang = collectedData.language;

            // Generate structured content for PDF (only one language is selected)
            if (lang === 'english') {
                structures = structures.concat(getDocumentStructure(collectedData, 'english'));
            } else if (lang === 'spanish') {
                structures = structures.concat(getDocumentStructure(collectedData, 'spanish'));
            }
            
            // PDF Layout Constants (in points)
            const margin = 72; // 1 inch margin
            const pageWidth = doc.internal.pageSize.getWidth();
            const contentWidth = pageWidth - (2 * margin); // 612 - 144 = 468pt
            const lineHeight = 14; 
            const largeLineHeight = 24;
            let currentY = margin;
            let currentPage = 1;

            // Helper to check for and execute page break
            const checkPageBreak = (spaceNeeded = lineHeight) => {
                const bottomMargin = 720; // Approximately 1 inch from the bottom
                if (currentY + spaceNeeded > bottomMargin) {
                    doc.addPage();
                    currentY = margin;
                    currentPage++;
                }
            };

            // Main loop to iterate over structured content
            structures.forEach(item => {
                checkPageBreak(item.type === 'title' ? largeLineHeight * 2 : lineHeight);

                switch(item.type) {
                    case 'title':
                        doc.setFont('Times', 'bold');
                        doc.setFontSize(14);
                        doc.text(item.text, pageWidth / 2, currentY, { align: 'center' });
                        currentY += largeLineHeight * 2; // Extra space after title
                        break;

                    case 'intro':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        // The intro text is pre-formatted, we split only by bold placeholder to apply bold font style
                        const parts = item.text.split(/(\[PARENT_NAME\]|\[AGENT_NAME\]|\[ROLE_PARENT\]|\[ROLE_AGENT\]|\[PARENT_ADDRESS\]|\[AGENT_ADDRESS\]|\[PARENT_PHONE\]|\[AGENT_PHONE\])/); 
                        let cursorX = margin;
                        
                        parts.forEach(part => {
                            const isBold = part.startsWith(collectedData.parentName) || part.startsWith(collectedData.agentName) || part.startsWith('_________________________') || part.includes('APPOINT');
                            
                            // Re-check for bolding on dynamic parts, as the replacement happens in getDocumentStructure
                            if (part.includes(collectedData.parentName) || part.includes(collectedData.agentName)) {
                                doc.setFont('Times', 'bold');
                            } else {
                                doc.setFont('Times', 'normal');
                            }
                            
                            const partWidth = doc.getTextWidth(part);
                            
                            // Check if line wrap is necessary
                            if (cursorX + partWidth > pageWidth - margin) {
                                currentY += lineHeight;
                                checkPageBreak();
                                cursorX = margin;
                            }
                            
                            doc.text(part, cursorX, currentY);
                            cursorX += partWidth;
                        });
                        currentY += lineHeight;
                        break;
                    
                    case 'child-item':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        doc.text(item.text, margin + 20, currentY);
                        currentY += lineHeight;
                        break;

                    case 'heading':
                        doc.setFont('Times', 'bold');
                        doc.setFontSize(11);
                        doc.text(`${item.num} ${item.text}`, margin, currentY);
                        currentY += lineHeight;
                        break;
                    
                    case 'paragraph':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        let textToWrap = item.text.replace('NOT', 'NOT'); 
                        const wrappedText = doc.splitTextToSize(textToWrap, contentWidth);
                        doc.text(wrappedText, margin, currentY);
                        currentY += wrappedText.length * lineHeight;
                        currentY += 5; // Small space after paragraph
                        break;
                    
                    case 'paragraph-sub':
                         doc.setFont('Times', 'normal');
                         doc.setFontSize(11);
                         const subTextWrapped = doc.splitTextToSize(item.text, contentWidth - 20); // indent 20 points
                         doc.text(subTextWrapped, margin + 20, currentY);
                         currentY += subTextWrapped.length * lineHeight;
                         currentY += 5; // Small space after paragraph
                         break;

                    case 'paragraph-small':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(10);
                        const wrappedSmallText = doc.splitTextToSize(item.text, contentWidth);
                        doc.text(wrappedSmallText, margin, currentY);
                        currentY += wrappedSmallText.length * lineHeight;
                        currentY += 5; // Small space after paragraph
                        break;

                    case 'power-item':
                        // Power item: [___] Initial. Text
                        doc.setFontSize(11);
                        const initialBoxX = margin;
                        const initialBoxY = currentY - 8; // Adjust Y for vertical centering
                        const initialTextX = initialBoxX + 2;
                        const initialCodeX = initialBoxX + 25; // Where P.C. goes
                        const powerTextX = initialBoxX + 90; // Start text far right
                        
                        // Draw box
                        doc.rect(initialBoxX, initialBoxY, 15, 10);
                        // Draw X if checked
                        if (item.checked === 'X') {
                            doc.setFont('Times', 'bold');
                            doc.text(item.checked, initialTextX + 1, currentY);
                        }
                        
                        // Write Initial Code (P.C., S.E., etc.)
                        doc.setFont('Times', 'normal');
                        doc.text(`${item.initial}.`, initialCodeX, currentY);

                        // Write Power Description
                        const wrappedPowerText = doc.splitTextToSize(item.text, contentWidth - 90); // Content - Left offset
                        doc.text(wrappedPowerText, powerTextX, currentY);
                        currentY += wrappedPowerText.length * lineHeight;
                        break;

                    case 'list-alpha':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        // Indent list items
                        const wrappedListText = doc.splitTextToSize(item.text, contentWidth - 20);
                        doc.text(wrappedListText, margin + 20, currentY);
                        currentY += wrappedListText.length * lineHeight;
                        break;
                    
                    case 'notary-separator':
                        currentY += 20;
                        break;
                    case 'notary-separator-small':
                        currentY += 10;
                        break;

                    case 'notary-title':
                        doc.setFont('Times', 'bold');
                        doc.setFontSize(12);
                        doc.text(item.text, pageWidth / 2, currentY, { align: 'center' });
                        currentY += largeLineHeight;
                        break;

                    case 'signature-line':
                        currentY += lineHeight * 2; // Space for signature line
                        doc.line(margin + 50, currentY, pageWidth - margin - 50, currentY); // Draw line
                        currentY += 15;
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        doc.text(item.name, pageWidth / 2, currentY, { align: 'center' }); // Print name centered
                        currentY += 10;
                        doc.setFontSize(9);
                        doc.text(item.role, pageWidth / 2, currentY, { align: 'center' }); // Print role centered
                        currentY += largeLineHeight;
                        break;
                    
                    case 'notary-state':
                    case 'notary-expire':
                    case 'notary-seal':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        doc.text(item.text, margin, currentY);
                        currentY += lineHeight;
                        break;

                    case 'notary-text':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        const notaryTextWrapped = doc.splitTextToSize(item.text.replace(/<.*?>/g, ''), contentWidth); // Remove HTML bold tags for PDF
                        doc.text(notaryTextWrapped, margin, currentY);
                        currentY += notaryTextWrapped.length * lineHeight;
                        currentY += 10;
                        break;
                    
                    case 'notary-witness':
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(11);
                        doc.text(item.text, margin, currentY);
                        currentY += lineHeight * 2;
                        break;
                    
                    case 'notary-sign-line':
                        currentY += lineHeight;
                        doc.line(margin, currentY, pageWidth / 2, currentY); // Draw line (half width)
                        currentY += 10;
                        doc.setFont('Times', 'normal');
                        doc.setFontSize(9);
                        doc.text(item.text, margin, currentY);
                        currentY += largeLineHeight;
                        break;
                    
                    case 'footer':
                        doc.setFont('Times', 'bold');
                        doc.setFontSize(9);
                        doc.text(item.text, pageWidth - margin, doc.internal.pageSize.getHeight() - 40, { align: 'right' });
                        doc.text(`[${lang.toUpperCase()}]`, margin, doc.internal.pageSize.getHeight() - 40); // Add language footer
                        currentY += lineHeight;
                        break;

                    case 'page-break-placeholder':
                        // Force a page break if we are near the top of the current page.
                        if (currentY < 360) {
                            checkPageBreak(720); // If less than halfway down, force break to start Page 2 properly
                        }
                        currentY += 10; // Simple spacing when page break isn't forced
                        break;
                }
            });
            
            doc.save(`Custodial_POA_${lang}.pdf`);

            // Provide user feedback
            const pdfButton = document.getElementById('pdfButton');
            pdfButton.textContent = 'PDF Downloaded!';
            pdfButton.classList.remove('bg-red-600', 'hover:bg-red-700');
            pdfButton.classList.add('bg-green-600', 'hover:bg-green-700');
            
            setTimeout(() => {
                pdfButton.textContent = 'Download PDF (Corrected Format)';
                pdfButton.classList.remove('bg-green-600', 'hover:bg-green-700');
                pdfButton.classList.add('bg-red-600', 'hover:bg-red-700');
            }, 2000);
        }
    </script>
